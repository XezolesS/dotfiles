# auto colors for grep
alias grep="grep --color=auto"

# fgrep: grep -F
alias fgrep="grep -F"

# egrep: grep -E
alias egrep="grep -E"

# neovim aliases
alias nv="nvim"
alias sunv="sudoedit"
alias sued="sudoedit"

# tmux aliases
alias tm="tmux"
alias tmls="tmux ls"
alias tmat="tmux attach -t"
alias tmrm="tmux kill-session -t"
